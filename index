<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>台股 K 棒走圖練習與模擬交易系統</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts: Noto Sans TC 與 JetBrains Mono (等寬數字字體) -->
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: #0b0e14;
            color: #e2e8f0;
            user-select: none;
        }
        .font-mono-num {
            font-family: 'JetBrains Mono', monospace;
            font-variant-numeric: tabular-nums;
        }
        /* 自訂捲軸樣式 */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #131722;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2e39;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #434651;
        }
        /* 時間軸滑桿樣式 */
        input[type="range"] {
            -webkit-appearance: none;
            background: #1e222d;
            height: 6px;
            border-radius: 3px;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #3b82f6;
            cursor: pointer;
            border: 2px solid #ffffff;
        }
        /* 日期選擇器深色模式修正 */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden">

    <!-- 頂部導覽與股票/日期設定列 -->
    <header class="bg-[#131722] border-b border-[#2a2e39] px-4 py-3 shadow-md">
        <div class="max-w-[1600px] mx-auto flex flex-wrap items-center justify-between gap-3">
            <!-- 標題與 Logo -->
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-red-500 to-emerald-500 flex items-center justify-center font-bold text-white shadow">
                    K
                </div>
                <div>
                    <h1 class="text-base md:text-lg font-bold tracking-wide text-white">台股 K 棒走圖實戰訓練室</h1>
                    <p class="text-[11px] text-slate-400 hidden sm:block">盲測走圖 · 歷史回看 · 精準成本損益試算</p>
                </div>
            </div>

            <!-- 股票代號與區間設定表單 -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-sm">
                <!-- 股票代號輸入與快速選擇 -->
                <div class="flex items-center bg-[#1e222d] border border-[#2a2e39] rounded-lg px-2.5 py-1.5">
                    <label for="stockCodeInput" class="text-slate-400 text-xs mr-2 whitespace-nowrap">股號</label>
                    <input type="text" id="stockCodeInput" value="2330" placeholder="如 2330" maxlength="10"
                        class="w-20 bg-transparent text-white font-mono-num font-bold focus:outline-none uppercase">
                    <select id="presetStockSelect" class="bg-[#131722] text-xs text-slate-300 border border-[#2a2e39] rounded px-1.5 py-0.5 ml-1 focus:outline-none cursor-pointer">
                        <option value="2330">2330 台積電</option>
                        <option value="2454">2454 聯發科</option>
                        <option value="2327">2327 國巨</option>
                        <option value="2408">2408 南亞科</option>
                        <option value="2603">2603 長榮</option>
                        <option value="0050">0050 元大台灣50</option>
                    </select>
                </div>

                <!-- 起始與結束日期 -->
                <div class="flex items-center bg-[#1e222d] border border-[#2a2e39] rounded-lg px-2.5 py-1.5 gap-2">
                    <span class="text-slate-400 text-xs whitespace-nowrap">區間</span>
                    <input type="date" id="startDateInput" value="2025-01-02"
                        class="bg-transparent text-white font-mono-num text-xs focus:outline-none">
                    <span class="text-slate-500">~</span>
                    <input type="date" id="endDateInput" value="2025-12-31"
                        class="bg-transparent text-white font-mono-num text-xs focus:outline-none">
                </div>

                <!-- 載入/套用按鈕 -->
                <button id="loadDataBtn"
                    class="bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-medium px-3.5 py-1.5 rounded-lg transition shadow flex items-center gap-1.5 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    <span>載入走圖</span>
                </button>

                <!-- 匯入自訂 CSV/JSON -->
                <button id="openImportModalBtn"
                    class="bg-[#1e222d] hover:bg-[#2a2e39] text-slate-300 border border-[#2a2e39] font-medium px-3 py-1.5 rounded-lg transition text-xs cursor-pointer">
                    匯入數據
                </button>
            </div>
        </div>
    </header>

    <!-- 訊息提示橫幅 (取代 alert) -->
    <div id="toastBanner" class="fixed top-16 left-1/2 transform -translate-x-1/2 z-50 hidden transition-all duration-300">
        <div id="toastContent" class="px-4 py-2.5 rounded-lg shadow-xl border text-sm font-medium flex items-center gap-2"></div>
    </div>

    <!-- 主工作區：左側 K 線圖表 + 右側買賣交易面板 -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto p-3 md:p-4 grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- 左側：K 線看盤與歷史回看區 (佔 8 欄) -->
        <section class="lg:col-span-8 flex flex-col bg-[#131722] border border-[#2a2e39] rounded-xl overflow-hidden shadow-lg">
            
            <!-- 頂部 OHLCV 即時資訊與均線開關列 -->
            <div class="px-4 py-2.5 bg-[#181c27] border-b border-[#2a2e39] flex flex-wrap items-center justify-between gap-2 text-xs">
                <!-- 股票名稱與懸停 K 棒資訊 -->
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono-num">
                    <span id="displayStockTitle" class="text-sm font-bold text-white font-sans">2330 台積電</span>
                    <span class="text-slate-400">日期: <strong id="infoDate" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">開: <strong id="infoOpen" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">高: <strong id="infoHigh" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">低: <strong id="infoLow" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">收: <strong id="infoClose" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">漲跌: <strong id="infoChange" class="text-slate-200">--</strong></span>
                    <span class="text-slate-400">量: <strong id="infoVol" class="text-slate-200">--</strong></span>
                </div>

                <!-- 均線開關 -->
                <div class="flex items-center gap-3">
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" id="toggleMA5" checked class="accent-amber-400 rounded">
                        <span class="text-amber-400 font-mono-num">5MA</span>
                    </label>
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" id="toggleMA10" checked class="accent-sky-400 rounded">
                        <span class="text-sky-400 font-mono-num">10MA</span>
                    </label>
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" id="toggleMA20" checked class="accent-purple-400 rounded">
                        <span class="text-purple-400 font-mono-num">20MA</span>
                    </label>
                </div>
            </div>

            <!-- Canvas 繪圖容器 -->
            <div id="chartContainer" class="relative w-full h-[380px] sm:h-[450px] md:h-[490px] bg-[#0f131a] cursor-crosshair">
                <canvas id="klineCanvas" class="block w-full h-full"></canvas>
                <!-- 操作提示浮標 -->
                <div class="absolute bottom-2 left-3 text-[11px] text-slate-500 pointer-events-none bg-[#0f131a]/80 px-2 py-0.5 rounded">
                    滾輪縮放 · 按住左鍵拖曳回看歷史 K 棒 · 鍵盤 ← / → 單步走圖
                </div>
            </div>

            <!-- 歷史回看時間軸滑桿 -->
            <div class="px-4 py-2 bg-[#181c27] border-t border-[#2a2e39] flex items-center gap-3">
                <span class="text-xs text-slate-400 whitespace-nowrap">歷史視窗回看</span>
                <input type="range" id="historyScrollSlider" min="0" max="0" value="0" class="flex-1">
                <button id="jumpToLatestBtn" class="text-xs bg-[#2a2e39] hover:bg-slate-600 text-slate-200 px-2.5 py-1 rounded transition whitespace-nowrap cursor-pointer">
                    回到最新 K 棒
                </button>
            </div>

            <!-- 走圖播放控制列 -->
            <div class="p-3 bg-[#131722] border-t border-[#2a2e39] flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <button id="prevBarBtn" title="上一根 K 棒 (鍵盤左鍵)"
                        class="bg-[#1e222d] hover:bg-[#2a2e39] active:scale-95 text-slate-200 border border-[#2a2e39] px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1 cursor-pointer">
                        <span>◀ 上一根</span>
                    </button>

                    <button id="nextBarBtn" title="下一根 K 棒 (鍵盤右鍵)"
                        class="bg-blue-600 hover:bg-blue-500 active:scale-95 text-white px-4 py-2 rounded-lg text-sm font-bold transition shadow flex items-center gap-1.5 cursor-pointer">
                        <span>下一根 K 棒 ▶</span>
                    </button>

                    <button id="autoPlayBtn"
                        class="bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/40 px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5 cursor-pointer">
                        <span id="autoPlayIcon">▶</span>
                        <span id="autoPlayText">自動走圖</span>
                    </button>

                    <select id="playSpeedSelect" class="bg-[#1e222d] text-xs text-slate-300 border border-[#2a2e39] rounded-lg px-2 py-2 focus:outline-none cursor-pointer">
                        <option value="1200">慢速 (1.2秒)</option>
                        <option value="700" selected>中速 (0.7秒)</option>
                        <option value="300">快速 (0.3秒)</option>
                    </select>
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-xs text-slate-400 font-mono-num">
                        進度: <strong id="progressText" class="text-white">0 / 0</strong> 根
                    </span>
                    <button id="resetSimBtn"
                        class="bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 px-3 py-2 rounded-lg text-xs font-medium transition cursor-pointer">
                        重置練習
                    </button>
                </div>
            </div>
        </section>

        <!-- 右側：買進/賣出定價下單與損益精算區 (佔 4 欄) -->
        <section class="lg:col-span-4 flex flex-col gap-4">
            
            <!-- 買賣定價下單卡片 -->
            <div class="bg-[#131722] border border-[#2a2e39] rounded-xl p-4 shadow-lg">
                <div class="flex items-center justify-between border-b border-[#2a2e39] pb-2.5 mb-3">
                    <h2 class="text-base font-bold text-white flex items-center gap-2">
                        <span class="w-2 h-5 bg-blue-500 rounded-sm"></span>
                        模擬買賣定價下單
                    </h2>
                    <span id="currentTradeDateBadge" class="text-xs font-mono-num bg-[#1e222d] text-slate-300 px-2 py-0.5 rounded border border-[#2a2e39]">
                        ----/--/--
                    </span>
                </div>

                <!-- 交易參數設定 (手續費折數 / 證交稅) -->
                <div class="grid grid-cols-2 gap-2.5 mb-3 bg-[#181c27] p-2.5 rounded-lg border border-[#2a2e39] text-xs">
                    <div>
                        <label class="text-slate-400 block mb-1">手續費折數 (0.1425%)</label>
                        <div class="flex items-center gap-1">
                            <input type="number" id="feeDiscountInput" value="2.8" step="0.1" min="0.1" max="10"
                                class="w-full bg-[#0f131a] border border-[#2a2e39] rounded px-2 py-1 text-white font-mono-num focus:border-blue-500 focus:outline-none">
                            <span class="text-slate-400 whitespace-nowrap">折</span>
                        </div>
                    </div>
                    <div>
                        <label class="text-slate-400 block mb-1">證交稅率 (賣出課徵)</label>
                        <select id="taxRateSelect" class="w-full bg-[#0f131a] border border-[#2a2e39] rounded px-2 py-1 text-white font-mono-num focus:border-blue-500 focus:outline-none">
                            <option value="0.003">0.3% (一般股票)</option>
                            <option value="0.001">0.1% (ETF)</option>
                        </select>
                    </div>
                </div>

                <!-- 定價與張數輸入欄位 -->
                <div class="space-y-3">
                    <!-- 委託定價欄 -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label for="orderPriceInput" class="text-xs text-slate-300 font-medium">買進 / 賣出定價 (元)</label>
                            <div class="flex gap-1 text-[11px]">
                                <button type="button" id="setOpenPriceBtn" class="px-1.5 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-slate-300 rounded cursor-pointer">開盤</button>
                                <button type="button" id="setClosePriceBtn" class="px-1.5 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-blue-400 rounded cursor-pointer">收盤</button>
                                <button type="button" id="setHighPriceBtn" class="px-1.5 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-red-400 rounded cursor-pointer">最高</button>
                                <button type="button" id="setLowPriceBtn" class="px-1.5 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-emerald-400 rounded cursor-pointer">最低</button>
                            </div>
                        </div>
                        <div class="relative flex items-center">
                            <input type="number" id="orderPriceInput" step="0.05"
                                class="w-full bg-[#0f131a] border border-[#2a2e39] focus:border-blue-500 rounded-lg px-3 py-2 text-lg font-bold font-mono-num text-white focus:outline-none">
                            <span id="priceRangeHint" class="absolute right-3 text-[11px] text-slate-400 font-mono-num">
                                區間: -- ~ --
                            </span>
                        </div>
                        <div class="mt-1 flex items-center justify-between text-[11px] text-slate-400">
                            <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="strictRangeCheck" checked class="accent-blue-500 rounded">
                                <span>嚴格檢核定價需介於當日高低點之間</span>
                            </label>
                        </div>
                    </div>

                    <!-- 委託張數欄 -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label for="orderLotsInput" class="text-xs text-slate-300 font-medium">交易張數 (1 張 = 1,000 股)</label>
                            <div class="flex gap-1 text-[11px]">
                                <button type="button" data-lots="1" class="quick-lot-btn px-2 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-slate-300 rounded cursor-pointer">1張</button>
                                <button type="button" data-lots="2" class="quick-lot-btn px-2 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-slate-300 rounded cursor-pointer">2張</button>
                                <button type="button" data-lots="5" class="quick-lot-btn px-2 py-0.5 bg-[#1e222d] hover:bg-[#2a2e39] text-slate-300 rounded cursor-pointer">5張</button>
                                <button type="button" id="sellAllLotsBtn" class="px-2 py-0.5 bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-400 border border-emerald-700/40 rounded cursor-pointer">全數賣出</button>
                            </div>
                        </div>
                        <input type="number" id="orderLotsInput" value="1" min="1" step="1"
                            class="w-full bg-[#0f131a] border border-[#2a2e39] focus:border-blue-500 rounded-lg px-3 py-2 text-lg font-bold font-mono-num text-white focus:outline-none">
                    </div>

                    <!-- 即時買賣金額試算預覽框 -->
                    <div class="bg-[#181c27] border border-[#2a2e39] rounded-lg p-3 space-y-1.5 text-xs">
                        <div class="flex justify-between text-slate-400">
                            <span>成交總股數：</span>
                            <span id="calcShares" class="font-mono-num text-slate-200">1,000 股</span>
                        </div>
                        <div class="flex justify-between text-slate-400">
                            <span>買進預估總支出 (含手續費)：</span>
                            <span id="calcBuyTotal" class="font-mono-num font-bold text-red-400">$0</span>
                        </div>
                        <div class="flex justify-between text-slate-400">
                            <span>賣出預估實拿金額 (扣費與稅)：</span>
                            <span id="calcSellNet" class="font-mono-num font-bold text-emerald-400">$0</span>
                        </div>
                        <div class="border-t border-[#2a2e39] pt-1.5 flex justify-between items-center">
                            <span class="text-slate-300 font-medium">若以此價賣出庫存預估損益：</span>
                            <span id="calcEstProfit" class="font-mono-num font-bold text-sm text-slate-300">$0 (0.00%)</span>
                        </div>
                    </div>

                    <!-- 買進與賣出執行按鈕 (台股紅買綠賣) -->
                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <button id="buyBtn"
                            class="bg-red-600 hover:bg-red-500 active:scale-[0.98] text-white font-bold py-3 rounded-xl shadow-lg shadow-red-950/40 transition flex flex-col items-center justify-center cursor-pointer">
                            <span class="text-base">買進 (BUY)</span>
                            <span class="text-[11px] font-normal opacity-85">建立多單 / 加碼</span>
                        </button>
                        <button id="sellBtn"
                            class="bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-950/40 transition flex flex-col items-center justify-center cursor-pointer">
                            <span class="text-base">賣出 (SELL)</span>
                            <span class="text-[11px] font-normal opacity-85">平倉獲利 / 停損</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 帳戶部位與即時損益統計卡片 -->
            <div class="bg-[#131722] border border-[#2a2e39] rounded-xl p-4 shadow-lg flex-1 flex flex-col justify-between">
                <div>
                    <h2 class="text-base font-bold text-white flex items-center gap-2 border-b border-[#2a2e39] pb-2.5 mb-3">
                        <span class="w-2 h-5 bg-amber-500 rounded-sm"></span>
                        目前部位與損益精算
                    </h2>

                    <div class="grid grid-cols-2 gap-2.5 text-xs">
                        <div class="bg-[#181c27] p-2.5 rounded-lg border border-[#2a2e39]">
                            <span class="text-slate-400 block">持有庫存張數</span>
                            <strong id="posLots" class="text-lg font-mono-num text-white mt-0.5 block">0 張</strong>
                        </div>
                        <div class="bg-[#181c27] p-2.5 rounded-lg border border-[#2a2e39]">
                            <span class="text-slate-400 block">平均持有成本 (含費)</span>
                            <strong id="posAvgCost" class="text-lg font-mono-num text-amber-400 mt-0.5 block">0.00</strong>
                        </div>
                        <div class="bg-[#181c27] p-2.5 rounded-lg border border-[#2a2e39]">
                            <span class="text-slate-400 block">未實現浮動損益</span>
                            <strong id="unrealizedPnL" class="text-base font-mono-num text-slate-200 mt-0.5 block">$0 (0.00%)</strong>
                        </div>
                        <div class="bg-[#181c27] p-2.5 rounded-lg border border-[#2a2e39]">
                            <span class="text-slate-400 block">已實現累積淨損益</span>
                            <strong id="realizedPnL" class="text-base font-mono-num text-slate-200 mt-0.5 block">$0</strong>
                        </div>
                    </div>
                </div>

                <!-- 總損益結算橫幅 -->
                <div class="mt-3 bg-[#0f131a] border border-[#2a2e39] rounded-lg p-3 flex items-center justify-between">
                    <div>
                        <span class="text-xs text-slate-400 block">總淨損益 (已實現 + 未實現)</span>
                        <span class="text-[11px] text-slate-500">已扣除買賣手續費與證交稅</span>
                    </div>
                    <div id="totalPnL" class="text-xl font-bold font-mono-num text-white">$0</div>
                </div>
            </div>
        </section>

        <!-- 下方：交易明細紀錄表 (全寬 12 欄) -->
        <section class="lg:col-span-12 bg-[#131722] border border-[#2a2e39] rounded-xl overflow-hidden shadow-lg">
            <div class="px-4 py-3 bg-[#181c27] border-b border-[#2a2e39] flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <span>📋 模擬交易明細與損益對帳單</span>
                    <span id="tradeCountBadge" class="bg-blue-600/20 text-blue-400 text-xs px-2 py-0.5 rounded-full font-mono-num">0 筆</span>
                </h3>
